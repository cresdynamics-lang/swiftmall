generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OfferTag {
  NONE
  TODAY
  THIS_WEEK
  NEW
}

enum Gender {
  MENS
  WOMENS
  UNISEX
}

enum OrderStatus {
  NEW
  CONFIRMED
  PACKED
  DISPATCHED
  READY_FOR_PICKUP
  DELIVERED
  COLLECTED
  CANCELLED
  RETURNED
  CUSTOMER_UNREACHABLE
  DELIVERY_REFUSED
}

enum PaymentMethod {
  PAY_ON_ORDER
  DEPOSIT
  CASH_ON_DELIVERY
  PAY_ON_DELIVERY
  PAY_AT_PICKUP
}

enum PaymentState {
  PAID
  PART_PAID
  TO_COLLECT
  UNPAID
  AWAITING_MPESA
}

enum FulfilmentType {
  DELIVERY
  PICKUP
}

enum DeliveryZone {
  NAIROBI
  UPCOUNTRY
}

model Category {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  shortName String
  blurb     String
  sortOrder Int              @default(0)
  products  Product[]
  banners   HomepageBanner[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Product {
  id            String           @id @default(cuid())
  slug          String           @unique
  name          String
  description   String           @default("")
  brand         String?
  subCategory   String?
  sku           String?
  price         Int
  oldPrice      Int?
  stock         Int              @default(0)
  lowStockAt    Int              @default(3)
  images        String[]
  flashDeal     Boolean          @default(false)
  featured      Boolean          @default(false)
  live          Boolean          @default(true)
  offerTag      OfferTag         @default(NONE)
  gender        Gender?
  sizes         String[]
  sizePrices    Json?
  categoryId    String
  category      Category         @relation(fields: [categoryId], references: [id])
  sortOrder     Int              @default(0)
  orderItems    OrderItem[]
  bannerTiles1  HomepageBanner[] @relation("BannerTile1")
  bannerTiles2  HomepageBanner[] @relation("BannerTile2")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([categoryId])
  @@index([live, flashDeal])
  @@index([offerTag])
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  phone        String
  email        String?  @unique
  passwordHash String?
  county       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]

  @@index([phone])
}

model Order {
  id              String         @id @default(cuid())
  number          Int            @unique
  trackingToken   String         @unique @default(cuid())
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id])
  customerName    String
  phone           String
  email           String         @default("")
  privacyConsent  Boolean        @default(false)
  fulfilment      FulfilmentType @default(DELIVERY)
  zone            DeliveryZone?
  county          String         @default("")
  town            String         @default("")
  address         String         @default("")
  streetBuilding  String         @default("")
  landmark        String         @default("")
  deliveryNotes   String         @default("")
  collectorName   String         @default("")
  carrier         String?
  paymentMethod   PaymentMethod
  paymentState    PaymentState
  status          OrderStatus    @default(NEW)
  subtotal        Int
  shipping        Int
  total           Int
  depositPaid     Int            @default(0)
  amountExpected  Int            @default(0)
  amountConfirmed Int            @default(0)
  mpesaCode       String         @default("")
  cashCollected   Int            @default(0)
  cashCollectedBy String         @default("")
  cashCollectedAt DateTime?
  riderName       String         @default("")
  riderPhone      String         @default("")
  dispatchNote    String         @default("")
  note            String         @default("")
  customerNote    String         @default("")
  idempotencyKey  String?        @unique
  items           OrderItem[]
  events          OrderEvent[]
  emails          OutboundEmail[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([paymentMethod])
  @@index([paymentState])
  @@index([fulfilment])
  @@index([createdAt])
  @@index([email])
  @@index([phone])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  sku       String   @default("")
  image     String
  unitPrice Int
  qty       Int
  size      String?
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String      @default("")
  actor     String      @default("system")
  notify    Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model OutboundEmail {
  id        String    @id @default(cuid())
  orderId   String?
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  to        String
  subject   String
  template  String
  status    String    @default("queued")
  error     String    @default("")
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
}

model AdminAlert {
  id        String   @id @default(cuid())
  type      String
  title     String
  body      String   @default("")
  href      String   @default("/management/orders")
  read      Boolean  @default(false)
  orderId   String?
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  detail    String   @default("")
  orderId   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([orderId])
}

model StoreSettings {
  id              String    @id @default("default")
  shippingFlatKes Int       @default(250)
  depositShare    Float     @default(0.5)
  payOnOrder      Boolean   @default(true)
  depositEnabled  Boolean   @default(true)
  cashOnDelivery  Boolean   @default(true)
  payOnDelivery   Boolean   @default(true)
  carriers        String[]
  paybill         String    @default("880100")
  bankAccount     String    @default("9211670018")
  whatsappNumber  String    @default("0727383847")
  phoneNumber     String    @default("0727383847")
  contactEmail    String    @default("ww.swiftmall@gmail.com")
  flashEndsAt     DateTime?
  updatedAt       DateTime  @updatedAt
}

model HomepageBanner {
  id              String    @id @default(cuid())
  headline        String
  subheadline     String    @default("")
  copy            String    @default("")
  ctaLabel        String    @default("Shop now →")
  backgroundImage String?
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tile1ProductId  String?
  tile1Product    Product?  @relation("BannerTile1", fields: [tile1ProductId], references: [id], onDelete: SetNull)
  tile2ProductId  String?
  tile2Product    Product?  @relation("BannerTile2", fields: [tile2ProductId], references: [id], onDelete: SetNull)
  active          Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model OrderCounter {
  id   String @id @default("default")
  next Int    @default(1042)
}
